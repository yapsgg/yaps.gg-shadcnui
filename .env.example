# Redis connection (Vercel integration uses the prefixed name, e.g. YAPSGG_REDIS_URL)
# TCP URL form, e.g. rediss://default:password@host:port
YAPSGG_REDIS_URL=""
REDIS_URL=""

# AI provider: "deepseek" (default) or "google"
AI_PROVIDER="deepseek"

# DeepSeek (default provider)
DEEPSEEK_API_KEY=""

# Google Generative AI (only needed when AI_PROVIDER="google")
GOOGLE_GENERATIVE_AI_API_KEY=""

# Optional: override the model for the active provider
# default per provider -> deepseek: deepseek-flash, google: gemini-flash-latest
AI_MODEL=""
